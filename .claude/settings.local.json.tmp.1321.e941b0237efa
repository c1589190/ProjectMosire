      "Bash(git check-ignore *)",
      "Bash(git -C Research/repos/a2a-java status --short)",
      "Bash(git -C Research/repos/a2a-java log --oneline -1)",
      "Bash(git rm *)",
      "Bash(git add *)",
      "Read(//root/.claude/**)",
      "Read(//root/.claude/projects/**)",
      "Bash(git fetch *)",
      "Bash(git rev-list *)",
      "Bash(git commit -m ' *)",
      "Bash(git push *)"
    ]
  }
