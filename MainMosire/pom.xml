<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.mosire</groupId>
    <artifactId>mosire-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>main-mosire</artifactId>
  <name>MainMosire</name>
  <description>入口/网关：进程组装、CLI、AdminREST、AG-UI/A2A/MCP 协议入口、健康检查、发行（不含 Agent 行为逻辑）</description>

  <dependencies>
    <dependency>
      <groupId>io.mosire</groupId>
      <artifactId>brain-mosire</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.mosire</groupId>
      <artifactId>agentlib-mosire</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <!-- SpotBugs 抑制注解：网关/装配层“设计意图”告警标记（R8 中断语义 offer、fail-fast start、注入持有器等——编译期仅为注解）；
         与 BrainMosire 同款（见 BrainMosire/pom.xml 对应条目） -->
    <dependency>
      <groupId>com.github.spotbugs</groupId>
      <artifactId>spotbugs-annotations</artifactId>
      <version>4.10.4</version>
      <scope>provided</scope>
    </dependency>
    <!-- AdminREST JSON（版本由根 pom jackson-bom 管理） -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- A2A 官方 SDK（版本由根 pom a2a-java-sdk-bom 管理）：
         服务端只用 spec + jsonrpc-common（决策 D6：不引 server-common/CDI/Vert.x server 栈）；
         客户端用官方 client + jsonrpc transport（对 Vert.x 有传递依赖，属网关侧重型约束，网络面后续再评估） -->
    <dependency>
      <groupId>org.a2aproject.sdk</groupId>
      <artifactId>a2a-java-sdk-spec</artifactId>
    </dependency>
    <dependency>
      <groupId>org.a2aproject.sdk</groupId>
      <artifactId>a2a-java-sdk-jsonrpc-common</artifactId>
    </dependency>
    <dependency>
      <groupId>org.a2aproject.sdk</groupId>
      <artifactId>a2a-java-sdk-client</artifactId>
    </dependency>
    <dependency>
      <groupId>org.a2aproject.sdk</groupId>
      <artifactId>a2a-java-sdk-client-transport-jsonrpc</artifactId>
    </dependency>
    <!-- 运行侧日志实现：SLF4J + Log4j2（既有工程约定） -->
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-core</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-slf4j2-impl</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- 单 jar 发行（决策 D4/D11）：finalName=mosire → target/mosire.jar；
           ServicesResourceTransformer 合并 MCP 的 META-INF/services（mcp-json-jackson2 SPI） -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <finalName>mosire</finalName>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.mosire.main.Main</mainClass>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
